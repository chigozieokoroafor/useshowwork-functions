{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "workers/bullmq/**/*.ts",
    "workers/publishing/**/*.ts",
    "lib/queues/**/*.ts",
    "lib/redis.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-worker"
  ]
}
