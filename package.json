{
  "name": "showwork-publishing-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Showwork standalone publishing worker, background jobs, and Netlify function runners",
  "main": "dist-worker-native/run-workers.mjs",
  "scripts": {
    "worker:build": "node scripts/vps/build-bullmq-worker.mjs",
    "worker:check": "node dist-worker-native/run-workers.mjs --check",
    "worker:run": "node dist-worker-native/run-workers.mjs --run",
    "worker:reconcile": "node dist-worker-native/run-workers.mjs --reconcile",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "postinstall": "prisma generate",
    "prestart": "npx prisma db pull",
    "worker:bullmq:build": "node scripts/vps/build-bullmq-worker.mjs",
    "worker:bullmq": "node dist-worker-native/run-workers.mjs --run",
    "worker:bullmq:check": "node dist-worker-native/run-workers.mjs --check",
    "start": "node dist-worker-native/run-workers.mjs --run",
    "ai-worker:build": "node scripts/vps/build-bullmq-worker.mjs",
    "ai-worker:start": "node dist-worker-native/run-workers.mjs --run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@netlify/functions": "^5.3.0",
    "@prisma/client": "^5.20.0",
    "bullmq": "^6.3.15",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "heic-convert": "^2.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "resend": "^4.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "esbuild": "0.25.12",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2"
  }
}
