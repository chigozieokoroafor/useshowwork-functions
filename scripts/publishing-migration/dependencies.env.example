# REVIEW TEMPLATE ONLY; do not source as a working deployment configuration.
# The application hook and native worker command are implemented. Keep both off.
# Application installation never grants provider send authority; the worker also
# requires --run and matching durable VPS ownership before execution.
SHOWWORK_PUBLISHING_PROTOCOL=canonical
SHOWWORK_PUBLISHING_ENABLED=false
SHOWWORK_CANONICAL_APPLICATION_ENABLED=false
# Explicit --reconcile permits status lookups only under matching DRAINING ownership.
PUBLISHING_RECONCILIATION_ENABLED=false
# Approved application schema; direct/session/transaction-compatible connection,
# never statement pooling. Deliver actual URLs via private credential files.
PUBLISHING_DATABASE_SCHEMA=public
PUBLISHING_DATABASE_POOL_MAX=3
PUBLISHING_WORKER_CONCURRENCY=2
PUBLISHING_WORKER_POLL_MS=5000
PUBLISHING_OWNER=VPS
# Required only after audited transition; do not guess or hard-code an epoch.
PUBLISHING_EXPECTED_EPOCH=
PUBLISHING_DATABASE_URL=
PUBLISHING_STORAGE_ENDPOINT=
PUBLISHING_STORAGE_BUCKET=
PUBLISHING_STORAGE_JOURNAL_PREFIX=publishing/production/
PUBLISHING_STORAGE_ACCESS_KEY_ID=
PUBLISHING_STORAGE_SECRET_ACCESS_KEY=
PUBLISHING_MEDIA_PUBLIC_ORIGIN=
META_API_VERSION=v26.0
LINKEDIN_API_VERSION=202609
# Existing trusted OAuth services read these server-only variable names.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Next application only, not public browser variables; preserve existing services.
JWT_SECRET=
CRON_SECRET=
PAYSTACK_SECRET_KEY=
# Verify callback secrets, provider scopes/app approvals and billing modes before
# allowing external I/O. Never place access/refresh tokens in release archives.

# Next application admin authority: preserve the existing approved allowlist.
# Deliberately empty here; this is not a new admin grant.
ADMIN_EMAILS=

# Canonical application Prisma and SQL clients both use PUBLISHING_DATABASE_URL.
# Existing notification service; no new delivery or billing policy.
RESEND_API_KEY=
