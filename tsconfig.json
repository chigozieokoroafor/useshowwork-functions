{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "workers/**/*.ts",
    "lib/**/*.ts",
    "netlify/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs"
  ],
  "exclude": [
    "node_modules",
    "dist*"
  ]
}
